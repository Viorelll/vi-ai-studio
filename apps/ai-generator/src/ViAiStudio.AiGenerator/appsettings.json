{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "vi-ai-studio-builds"
  },
  "AiGenerator": {
    "WebhookSecret": "dev-webhook-secret"
  },
  "Sandbox": {
    "BackendImage": "mcr.microsoft.com/dotnet/sdk:10.0",
    "FrontendImage": "node:22-alpine",
    "DatabaseImage": "postgres:16-alpine",
    "CommandTimeout": "00:15:00",
    "MaxRepairAttempts": 4,
    "MaxInfraRetries": 2,
    "InfraRetryDelay": "00:00:05",
    "NugetCacheVolume": "vi-ai-nuget-cache",
    "NpmCacheVolume": "vi-ai-npm-cache"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  }
}
